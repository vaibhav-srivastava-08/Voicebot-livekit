# LiveKit server connection
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech/AI provider keys
CARTESIA_API_KEY=

# STT provider (see agent/stt_factory.py) - switch providers by changing STT_PROVIDER plus the
# matching API key below, no code change needed. Only the key matching STT_PROVIDER needs to
# actually be set.
STT_PROVIDER=deepgram

# deepgram (default)
DEEPGRAM_API_KEY=

# soniox - get a key at https://console.soniox.com
# SONIOX_API_KEY=

# LLM provider (see agent/llm_factory.py) - switch providers by changing LLM_PROVIDER plus the
# matching API key and model names below, no code change needed. Only the key matching
# LLM_PROVIDER needs to actually be set.
LLM_PROVIDER=groq

# groq (default) - model examples: openai/gpt-oss-20b (fast) / openai/gpt-oss-120b (smart)
GROQ_API_KEY=

# google (Gemini) - model examples: gemini-2.5-flash-lite (fast) / gemini-2.5-flash (smart)
# Either an API key from https://aistudio.google.com/apikey ...
# GOOGLE_API_KEY=
# ... or a GCP service account (Vertex AI) - set GOOGLE_USE_VERTEXAI=true plus
# GOOGLE_APPLICATION_CREDENTIALS pointing at the service account JSON key file.
# GOOGLE_VERTEX_PROJECT is only needed if it can't be inferred from that file.
# GOOGLE_USE_VERTEXAI=true
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-service-account.json
# GOOGLE_VERTEX_PROJECT=
# GOOGLE_VERTEX_LOCATION=us-central1

# openai - also covers any OpenAI-compatible endpoint (OpenRouter, Together, a local
# vLLM/Ollama server, ...) via LLM_BASE_URL. Model examples: gpt-4o-mini (fast) / gpt-4o (smart)
# OPENAI_API_KEY=
# LLM_BASE_URL=

# Redis
REDIS_URL=redis://localhost:6379/0

# Bridge server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Agent
AGENT_LOG_LEVEL=INFO
CARTESIA_VOICE_ID=
PREEMPTIVE_GENERATION_ENABLED=true
FAST_LLM_MODEL=openai/gpt-oss-20b
SMART_LLM_MODEL=openai/gpt-oss-120b
ENABLE_TWO_TIER_LLM=false
RESPONSE_GUARD_ENABLED=true
# ENDPOINTING_MIN_DELAY_S=0.5

# Worker scaling (see DEPLOY.md's "Scaling knobs" section) - defaults reproduce this project's
# previous hardcoded local/dev behavior, uncomment and tune for production.
# NUM_IDLE_PROCESSES=2
# WORKER_LOAD_THRESHOLD=0.7
# JOB_MEMORY_LIMIT_MB=0
# DRAIN_TIMEOUT=3600
